{
  "name": "no-money",
  "version": "3.4.0",
  "private": true,
  "type": "module",
  "description": "没钱 No Money — 灵活就业者收入精算与权益决策平台（企业级）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "tsx scripts/verify-engines.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon src-tauri/icons/1024x1024.png",
    "kb:export": "tsx scripts/export-kb.ts",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:test": "vue-tsc -p tsconfig.test.json --noEmit",
    "verify:reality": "tsx scripts/reality-check.ts",
    "kb:check": "tsx scripts/export-kb.ts --check",
    "lint": "vue-tsc --noEmit",
    "check": "npm run lint && npm test && npm run verify",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "cli": "tsx cli/index.ts",
    "mcp": "tsx mcp/server.ts",
    "api": "tsx server/api.ts",
    "api:build": "esbuild server/api.ts --bundle --platform=node --format=esm --outfile=dist-server/api.mjs --packages=external",
    "cli:build": "esbuild cli/index.ts --bundle --platform=node --format=esm --outfile=dist-cli/index.mjs --packages=external",
    "test:e2e:only": "playwright test",
    "build:entries": "npm run cli:build && npm run api:build",
    "verify:entrypoints": "tsx scripts/verify-entrypoints.ts",
    "doctor": "tsx scripts/doctor.ts",
    "rules:snapshot": "node scripts/rules-snapshot.mjs snapshot",
    "rules:verify": "node scripts/rules-snapshot.mjs verify",
    "rules:rollback": "node scripts/rules-snapshot.mjs rollback"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "naive-ui": "^2.38.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.44",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "21.0.4",
    "rollup-plugin-visualizer": "^7.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14",
    "zod": "^4.6.7"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "glob": "14.0.3",
    "deepmerge": "^4.3.1"
  }
}
