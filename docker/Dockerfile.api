# syntax=docker/dockerfile:1

# =====================================================================
# HTTP API 镜像（可选部署，默认只监听 127.0.0.1 的说明见 README）
# ---------------------------------------------------------------------
# 容器里监听 0.0.0.0 是唯一选择（否则宿主无法映射端口），
# 因此这个镜像默认带令牌桶限流（120/min/IP）与 64KB 请求体上限，
# 并建议只在可信网络/加反代鉴权后暴露。
# =====================================================================

FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

FROM deps AS build
COPY . .
# CLI 与 API 共用内核；这里只打包 API（--packages=external 保留 node_modules 依赖）
RUN npx esbuild server/api.ts --bundle --platform=node --format=esm \
      --outfile=dist-server/api.mjs --packages=external

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8787

# 只带运行期需要的部分：依赖 + 打包产物 + 规则数据
COPY package.json package-lock.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist-server ./dist-server
COPY --from=build /app/public/rules ./public/rules

# 只读文件系统：API 无状态不写盘，写权限只会放大被攻破后的影响面
RUN chmod -R a=rX /app && adduser -D -u 10001 appuser
USER appuser

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8787/health >/dev/null 2>&1 || exit 1

EXPOSE 8787
CMD ["node", "dist-server/api.mjs"]
